# ─── قاعدة البيانات (Neon) ───
# من لوحة Neon → Connection string، أو: neon connection-string production
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# ─── تسجيل الدخول (Auth.js) ───
# ولّد المفتاح بالأمر: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ─── جوجل OAuth ───
# من Google Cloud Console → APIs & Services → Credentials
# راجع دليل الإعداد خطوة بخطوة في README.md
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── معرّفات مجلدات الدرايف ───
# لا تُكتب داخل الكود إطلاقاً
DRIVE_ACCOUNTS_FOLDER_ID="1YCpJT2Qu4Ayvh2ZwCwcu1KA3qmDx_eor"
DRIVE_YEAR_2026_FOLDER_ID="1N8Lp4xxpHWuLgA1LWKpSe9Ox3GhAsEMl"
DRIVE_YEAR_2027_FOLDER_ID="1mG_zGvM8bljFyStmijGeY5cb9zeo-4Bq"

# ─── بيانات المنشأة ───
COMPANY_NAME_AR="مؤسسة ذا بوبليك هاوس"
COMPANY_VAT_NUMBER="310007971600003"
COMPANY_CR_NUMBER="7052766941"

# ─── استخراج بيانات الفواتير (Claude) ───
ANTHROPIC_API_KEY=""

# ─── مزوّد قراءة الفواتير ───
# claude = الأدق، مدفوع بالاستخدام، بياناتك ليست مادة تدريب
# ollama = مجاني تماماً وخاص تماماً، يعمل على جهازك، أقل دقة
#          الإعداد: ollama pull qwen2.5vl:7b
EXTRACTION_PROVIDER="claude"
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5vl:7b"

# ─── جيميني (طبقة مجانية) ───
# من https://aistudio.google.com/apikey
# تنبيه: شروط جوجل للطبقة المجانية تجيز استخدام بياناتك لتحسين منتجاتها
# ومراجعتها بشرياً. الطبقة المدفوعة وحدها لا تتدرّب على البيانات.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# قائمة نماذج تُدار بالتناوب — الحصّة المجانية ٢٠ طلباً/اليوم لكلّ نموذج،
# لا في الدقيقة. تُفصَل بفاصلة، وتُترَك فارغةً ليُستعمل `GEMINI_MODEL` وحده.
GEMINI_MODELS=""
# أساس التمهّل بين المحاولات بالمللي ثانية (افتراضه في الشيفرة)
GEMINI_RETRY_BASE_MS=""

# ─── مفتاح الدرايف ───
# يُولَّد بالأمر: npm run drive:auth  (وبصلاحية الكتابة: -- --write)
# وإن تُرك فارغاً قُرئ المخزَّن في القاعدة.
GOOGLE_DRIVE_REFRESH_TOKEN=""

# ─── الحَكَم بين مرشّحي المطابقة ───
# مزوّدٌ مستقلّ عن الاستخراج عمداً: الترجيح بين مرشّحين عملٌ غير قراءة
# فاتورة، وربطُهما بمتغيّر واحد يجعل تحسين أحدهما يُقلق الآخر.
# القيم: gemini · claude · deepseek · qwen
ADJUDICATOR_PROVIDER=""
# نموذجٌ بعينه — وإن تُرك فارغاً استُعمل المثبَّت في `extraction/versions.ts`
ADJUDICATOR_MODEL=""

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# ─── قراءة الكشف المصوَّر ───
# القيم: gemini · claude — وبلا اختيارٍ صريح يُؤخذ أوّلُ مهيَّأ.
VISION_PROVIDER=""

# ─── موصل المبيعات ───
# لا موصل مبنيّاً اليوم. والحال الافتراضي «غير موصول»: يرمي عند الطلب
# ولا يُرجع أصفاراً — لأنّ الصفر يقول إنّ المقهى لم يبع شيئاً.
SALES_CONNECTOR=""

# ─── قائمة الدخول البيضاء ───
# الصيغة: "بريد:دور,بريد:دور" — الأدوار: OWNER · ACCOUNTANT · PURCHASING
# لا أحد يدخل النظام ما لم يكن في هذه القائمة.
ALLOWED_EMAILS="ahmedaljaaidi98@gmail.com:OWNER"

# ─── وضع التجربة ───
# true يتخطّى تسجيل الدخول كلياً ويعطي صلاحية المالك.
# للتجربة وحدها: متى كان مفعّلاً فكل من يعرف الرابط يدخل.
# لا ترفع فواتير حقيقية وهو مشتغل.
AUTH_BYPASS="false"
