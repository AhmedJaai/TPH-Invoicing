# ─── قاعدة البيانات (Neon) ───
# من لوحة Neon → Connection string، أو: neon connection-string production
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# ─── تسجيل الدخول (Auth.js) ───
# ولّد المفتاح بالأمر: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ─── جوجل OAuth ───
# من Google Cloud Console → APIs & Services → Credentials
# راجع دليل الإعداد خطوة بخطوة في README.md
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── معرّفات مجلدات الدرايف ───
# لا تُكتب داخل الكود إطلاقاً
DRIVE_ACCOUNTS_FOLDER_ID="1YCpJT2Qu4Ayvh2ZwCwcu1KA3qmDx_eor"
DRIVE_YEAR_2026_FOLDER_ID="1N8Lp4xxpHWuLgA1LWKpSe9Ox3GhAsEMl"
DRIVE_YEAR_2027_FOLDER_ID="1mG_zGvM8bljFyStmijGeY5cb9zeo-4Bq"

# ─── بيانات المنشأة ───
COMPANY_NAME_AR="مؤسسة ذا بوبليك هاوس"
COMPANY_VAT_NUMBER="310007971600003"
COMPANY_CR_NUMBER="7052766941"

# ─── استخراج بيانات الفواتير (Claude) ───
ANTHROPIC_API_KEY=""

# ─── مزوّد قراءة الفواتير ───
# claude = الأدق، مدفوع بالاستخدام، بياناتك ليست مادة تدريب
# ollama = مجاني تماماً وخاص تماماً، يعمل على جهازك، أقل دقة
#          الإعداد: ollama pull qwen2.5vl:7b
EXTRACTION_PROVIDER="claude"
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5vl:7b"

# ─── جيميني (طبقة مجانية) ───
# من https://aistudio.google.com/apikey
# تنبيه: شروط جوجل للطبقة المجانية تجيز استخدام بياناتك لتحسين منتجاتها
# ومراجعتها بشرياً. الطبقة المدفوعة وحدها لا تتدرّب على البيانات.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# ─── قائمة الدخول البيضاء ───
# الصيغة: "بريد:دور,بريد:دور" — الأدوار: OWNER · ACCOUNTANT · PURCHASING
# لا أحد يدخل النظام ما لم يكن في هذه القائمة.
ALLOWED_EMAILS="ahmedaljaaidi98@gmail.com:OWNER"

# ─── وضع التجربة ───
# true يتخطّى تسجيل الدخول كلياً ويعطي صلاحية المالك.
# للتجربة وحدها: متى كان مفعّلاً فكل من يعرف الرابط يدخل.
# لا ترفع فواتير حقيقية وهو مشتغل.
AUTH_BYPASS="false"
