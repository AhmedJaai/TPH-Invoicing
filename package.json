{
  "name": "tph-invoicing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env scripts/seed-suppliers.ts",
    "drive:auth": "tsx --env-file=.env scripts/drive-auth.ts",
    "drive:inventory": "tsx --env-file=.env scripts/drive-inventory.ts",
    "drive:migrate": "tsx --env-file=.env scripts/migrate-archive.ts",
    "typecheck": "tsc --noEmit",
    "db:demo": "tsx --env-file=.env scripts/seed-demo.ts",
    "try": "tsx --env-file=.env scripts/try-extract.ts",
    "drive:diagnose": "tsx --env-file=.env scripts/diagnose-drive.ts",
    "try:archive": "tsx --env-file=.env scripts/try-archive.ts",
    "try:bank": "tsx --env-file=.env scripts/try-bank.ts",
    "try:match": "tsx --env-file=.env scripts/try-match.ts",
    "drive:backfill": "tsx --env-file=.env scripts/backfill-content.ts",
    "try:statement": "tsx --env-file=.env scripts/try-statement.ts",
